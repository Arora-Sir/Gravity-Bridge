# GravityBridge -- Environment Configuration Template
# ===================================================
# Copy this file to .env and fill in your values.
# .env is excluded from git and should NEVER be committed.
#
# Usage:
#   cp .env.example .env
#   nano .env   (or open in any text editor)

# Your secret passphrase for the lock screen.
# Use a strong phrase, not just a short number.
# Example: AUTH_PIN=mySecretPhrase2025!
AUTH_PIN=CHANGE_ME

# Full path to your ADB executable (required for Phone Drive Explorer).
# Download Platform Tools from: https://developer.android.com/tools/releases/platform-tools
# Example on Windows: ADB_EXECUTABLE_PATH=C:\platform-tools\adb.exe
ADB_EXECUTABLE_PATH=C:\your\path\to\adb.exe

# Your display name (used in AI system prompts).
# Example: USER_DISPLAY_NAME=Alex
USER_DISPLAY_NAME=CHANGE_ME

# Port the proxy listens on.
# Change this if the default port conflicts with another service.
PROXY_PORT=15842

# Tailscale device name of your Android phone (required for auto-detecting phone IP).
# If left empty, defaults to auto-detecting any device containing 'android'.
# Example: TAILSCALE_PHONE_NAME=s24-ultra
TAILSCALE_PHONE_NAME=CHANGE_ME

# Path to the GravityBridge project root.
# Example: GRAVITY_BRIDGE_PATH=C:\path\to\Gravity-Bridge
GRAVITY_BRIDGE_PATH=CHANGE_ME

# Active Spring Boot study/notes module path.
# Example: ACTIVE_SPRINGBOOT_PATH=C:\path\to\modules
ACTIVE_SPRINGBOOT_PATH=CHANGE_ME

# User Home Path.
# Example: USER_HOME_PATH=C:\Users\Username
USER_HOME_PATH=CHANGE_ME

